# Embedding backend: "tfidf" (default, no download, works immediately) or
# "sentence-transformers" (better semantic quality, requires installing
# sentence-transformers separately — see requirements.txt for details).
EMBEDDING_BACKEND=tfidf

# Only used if EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

PORT=8000
