# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local instance running on your laptop, e.g. via `mongod`)
MONGO_URI=mongodb://127.0.0.1:27017/interview_readiness

# Auth
# Generate a strong random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_NAME=irp_session

# CORS - your frontend's local URL
CLIENT_ORIGIN=http://localhost:3000

# AI service (see ../ai-service)
AI_SERVICE_URL=http://localhost:8000
